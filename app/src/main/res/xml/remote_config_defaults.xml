<?xml version="1.0" encoding="utf-8"?>
<defaultsMap>
    <!-- How often the background weather update job runs, in minutes. WorkManager minimum is 15. -->
    <entry>
        <key>weather_refresh_interval_minutes</key>
        <value>30</value>
    </entry>
    <!-- Delay between radar animation frames, in milliseconds. Higher is slower. -->
    <entry>
        <key>radar_frame_interval_ms</key>
        <value>850</value>
    </entry>
    <!-- Radar kill switch: false hides the radar section and skips RainViewer / OpenStreetMap
         fetches, for when either becomes unavailable. -->
    <entry>
        <key>radar_enabled</key>
        <value>true</value>
    </entry>
    <!-- Shows the "time to walk the dog" card; false hides it. -->
    <entry>
        <key>walk_card_enabled</key>
        <value>true</value>
    </entry>
    <!-- Forecasts for cities with coordinates: true uses Open-Meteo, false falls back to the
         OpenWeatherMap 3-hourly forecast by lat/lon. -->
    <entry>
        <key>open_meteo_enabled</key>
        <value>true</value>
    </entry>
    <!-- False stops fetching air quality: no Air quality tile, and the walk planner ignores the air. -->
    <entry>
        <key>air_quality_enabled</key>
        <value>true</value>
    </entry>
    <!-- Replacement OpenWeather API key for rotating a leaked one without an update. Empty uses
         the key built into the app. -->
    <entry>
        <key>openweather_api_key</key>
        <value></value>
    </entry>
    <entry>
        <key>android_min_supported_version</key>
        <value></value>
    </entry>
    <entry>
        <key>android_min_recommended_version</key>
        <value></value>
    </entry>
    <!-- Each kind of notification, for everyone: off stops it and hides its switch in Settings. -->
    <entry>
        <key>daily_weather_notifications_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>walk_time_notifications_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>rain_notifications_enabled</key>
        <value>true</value>
    </entry>
    <!-- Skip the silent foreground-resume refresh if this city was fetched within this many
         minutes (0..1440). 0 always refreshes. Pull-to-refresh is never throttled. -->
    <entry>
        <key>foreground_refresh_min_minutes</key>
        <value>0</value>
    </entry>
    <!-- Pet mood and walk advice thresholds, all Celsius whatever the user's units. Out-of-range
         values and unordered pairs (comfort min/max, walk hours start/end, pet cold/hot) fall back
         to these defaults; see PetWeatherThresholds. -->
    <entry>
        <key>walk_hot_pavement_c</key>
        <value>52</value>
    </entry>
    <entry>
        <key>walk_warm_pavement_c</key>
        <value>45</value>
    </entry>
    <entry>
        <key>walk_icy_pavement_c</key>
        <value>0</value>
    </entry>
    <entry>
        <key>walk_dangerous_pavement_c</key>
        <value>57.2</value>
    </entry>
    <entry>
        <key>walk_max_rain_chance</key>
        <value>30</value>
    </entry>
    <entry>
        <key>walk_comfort_min_c</key>
        <value>3</value>
    </entry>
    <entry>
        <key>walk_comfort_max_c</key>
        <value>27</value>
    </entry>
    <entry>
        <key>walk_hours_start</key>
        <value>7</value>
    </entry>
    <entry>
        <key>walk_hours_end</key>
        <value>20</value>
    </entry>
    <entry>
        <key>pet_hot_threshold_c</key>
        <value>30</value>
    </entry>
    <entry>
        <key>pet_cold_threshold_c</key>
        <value>0</value>
    </entry>
    <!-- Air quality band (0 good to 5 worst) from which hours aren't suggested for a walk. 3 is US
         "Unhealthy" and Europe's "Poor". Valid 1-5; anything else uses 3. -->
    <entry>
        <key>walk_bad_air_band</key>
        <value>3</value>
    </entry>
    <!-- Analytics kill switch: false drops every analytics event and turns Firebase Analytics
         collection off on every install, on top of the user's own "Share usage statistics" setting. -->
    <entry>
        <key>analytics_enabled</key>
        <value>true</value>
    </entry>
    <!-- One switch per Today tile, so any can be hidden for everyone. The UV tile is new and starts
         off; without it, UV stays in the Daylight tile's header. Air quality has air_quality_enabled. -->
    <entry>
        <key>tile_feels_like_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>tile_wind_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>tile_humidity_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>tile_paw_check_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>tile_uv_enabled</key>
        <value>false</value>
    </entry>
    <entry>
        <key>tile_daylight_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>tile_sky_enabled</key>
        <value>true</value>
    </entry>
</defaultsMap>
