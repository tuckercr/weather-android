    <!-- Notification text, written by worker/NotificationWorkerLogic.kt. Same wording as iOS's NotificationPlanner. -->
    <!-- Briefing title: %1$d is the temperature now, %2$s the conditions (notif_sky_*, or the rain's own description), %3$s the city. -->
    <string name="notif_briefing_title">%1$d° and %2$s in %3$s</string>
    <!-- Briefing body: today's high and low, with the chance of rain when it's 40% or more. -->
    <string name="notif_briefing_high_low">High %1$d°, low %2$d°.</string>
    <string name="notif_briefing_high_low_rain">High %1$d°, low %2$d°, %3$d%% chance of rain.</string>
    <!-- The briefing's walk sentence, with a dog. %1$s is the walk time ("1 PM"). -->
    <string name="notif_briefing_walk_now">Sunny says now\'s a great time for a walk.</string>
    <string name="notif_briefing_walk_at">Sunny\'s picked %1$s for a walk.</string>
    <string name="notif_briefing_no_walk">Not a good day for walkies.</string>
    <!-- Hurricane force wind in the hour under way, or from a later hour today (%1$s, such as "2 PM"):
         in place of the walk sentence with a dog, and added without one. -->
    <string name="notif_briefing_hurricane_now">Hurricane force winds. Stay inside, away from the windows.</string>
    <string name="notif_briefing_hurricane_from">Hurricane force winds from %1$s. Get everyone inside before then.</string>
    <!-- %1$s is notif_bad_air_today ("Smoky air today"). -->
    <string name="notif_briefing_bad_air_short">%1$s, so keep it short.</string>
    <string name="notif_briefing_bad_air_potty">%1$s, so potty breaks only.</string>
    <!-- %1$s is the air's name: walk_air_smoky, walk_air_dusty, walk_air_ozone or walk_air_poor. -->
    <string name="notif_bad_air_today">%1$s today</string>
    <!-- Walk time nudge. %1$d is the temperature, %2$s the conditions, %3$s the city. -->
    <string name="notif_walk_title">Time for a walk</string>
    <string name="notif_walk_body">%1$d° and %2$s in %3$s. Sunny\'s waiting by the door.</string>
    <!-- %1$s is notif_bad_air_today ("Smoky air today"). -->
    <string name="notif_walk_bad_air">%1$s, so a short one.</string>
    <!-- Hurricane force wind or likely storms in the 3 hours after the walk hour, in place of
         notif_walk_bad_air. %1$s is the hour they start, such as "4 PM". -->
    <string name="notif_walk_hurricane_from">Hurricane force winds from %1$s, so be back by then.</string>
    <string name="notif_walk_storms_from">Storms from %1$s, so be back by then.</string>
    <!-- Rain alert body (the title is next_rain_starting or next_snow_starting). %1$s is the city. -->
    <string name="notif_rain_body_dog">Rain on the way in %1$s. Walk now or wait it out.</string>
    <string name="notif_rain_body_no_dog">Rain on the way in %1$s. Misty\'s staying in.</string>
    <string name="notif_snow_body_dog">Snow on the way in %1$s. Walk now or wait it out.</string>
